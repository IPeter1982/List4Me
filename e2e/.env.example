API_URL=http://localhost:5058
WEB_URL=http://localhost:4173
TEST_DB_URL=postgres://postgres:postgres@localhost:5434/list4me_e2e

# Must match VITE_AUTH0_CLIENT_ID + VITE_AUTH0_AUDIENCE that the frontend was built with.
# In Test env the backend accepts any HS256-signed token whose audience is "list4me-test",
# so the Auth0 tenant does not need to be a real one.
VITE_AUTH0_CLIENT_ID=test-client
VITE_AUTH0_AUDIENCE=list4me-test
